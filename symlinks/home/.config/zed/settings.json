// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // *******************************************************************************
  // Application
  // *******************************************************************************
  "cli_default_open_behavior": "existing_window",

  // *******************************************************************************
  // Editor and Language
  // *******************************************************************************
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },

  "file_types": {
    "Shell Script": ["*.alias", ".zshrc.alias", ".zshrc.private"],
  },

  "languages": {
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier",
      "tab_size": 2,
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": "prettier",
      "tab_size": 2,
    },
  },

  // *******************************************************************************
  // Appearance
  // *******************************************************************************
  "buffer_font_family": "Inconsolata Nerd Font",
  "buffer_font_size": 15,
  "ui_font_size": 16,

  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "theme": "JetBrains Dark",

  // Boost saturation of the active theme's editor + syntax colors for a more
  // vibrant look, without switching away from JetBrains Dark.
  "experimental.theme_overrides": {
    "border.focused": "#4fd6ff",
    "editor.background": "#191a1c",
    "editor.gutter.background": "#191a1c",
    "text.accent": "#4fd6ff",
    "syntax": {
      "attribute": { "color": "#ffd23f" },
      "boolean": { "color": "#ff9e3f", "font_weight": 700 },
      "comment": { "color": "#8b949e", "font_style": "italic" },
      "comment.doc": { "color": "#a0a6b0", "font_style": "italic" },
      "constant": { "color": "#ff9e3f" },
      "constructor": { "color": "#4fc3ff" },
      "emphasis": { "font_style": "italic" },
      "emphasis.strong": { "font_weight": 700 },
      "function": { "color": "#4fd6ff" },
      "function.method": { "color": "#4fd6ff" },
      "keyword": { "color": "#ff5faf", "font_weight": 700 },
      "label": { "color": "#ffd94a" },
      "number": { "color": "#ff9e3f" },
      "operator": { "color": "#ff5faf" },
      "property": { "color": "#ffffff" },
      "punctuation": { "color": "#c9ccd3" },
      "string": { "color": "#5affa1" },
      "string.escape": { "color": "#ffd94a" },
      "string.special": { "color": "#5affa1" },
      "tag": { "color": "#ff5faf" },
      "type": { "color": "#ffd23f" },
      "type.builtin": { "color": "#26e0c0" },
      "variable": { "color": "#e6edf3" },
      "variable.special": { "color": "#ff9d3d" },
    },
  },

  // *******************************************************************************
  // Extensions
  // *******************************************************************************
  "auto_install_extensions": {
    "csharp": true,
    "dockerfile": true,
    "graphql": true,
    "html": true,
    "jetbrains-themes": true,
    "powershell": true,
    "sql": true,
    "terraform": true,
    "vscode-icons": true,
  },

  // *******************************************************************************
  // Panels and AI
  // *******************************************************************************
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "file_icons": true,
    "show_count_badge": true,
    "starts_open": true,
    "tree_view": true,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "bold_folder_labels": true,
    "dock": "left",
    "git_status_indicator": true,
    "hide_hidden": false,
    "hide_root": false,
  },

  // *******************************************************************************
  // Terminal
  // *******************************************************************************
  "terminal": {
    "font_family": "Inconsolata Nerd Font",
  },

  // *******************************************************************************
  // Privacy
  // *******************************************************************************
  "telemetry": {
    "anthropic_retention": false,
    "diagnostics": false,
    "metrics": false,
  },
}
