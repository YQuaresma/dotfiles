# Linux-only Ghostty config, loaded from ~/.config/ghostty/config via
# `config-file = ?config.linux`. Ubuntu/GNOME keybind conventions (Ctrl-based) that
# would clobber Ghostty's Cmd-based macOS defaults if placed in the shared
# config, so they live here instead.

# Clipboard
# Ctrl+C copies when there's a selection (matches GNOME apps), otherwise
# falls through to the terminal as SIGINT.
keybind = performable:ctrl+c=copy_to_clipboard:mixed
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+a=select_all

# Window & tab management
keybind = ctrl+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab:this
keybind = ctrl+q=quit

# Splits
keybind = ctrl+d=new_split:right
keybind = ctrl+alt+d=new_split:down
keybind = ctrl+[=goto_split:previous
keybind = ctrl+]=goto_split:next

# Search
keybind = ctrl+f=start_search
